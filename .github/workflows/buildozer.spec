[app]
title = YouTube Downloader Pro
package.name = ytdownloaderpro
package.domain = com.itpcfix
source.dir = .
source.include_exts = py,png,jpg,jpeg,kv,txt
version = 1.0.0
requirements = python3,kivy,yt-dlp,requests,pillow
orientation = portrait
fullscreen = 0
android.permissions = INTERNET,READ_MEDIA_VIDEO,READ_MEDIA_IMAGES,WRITE_EXTERNAL_STORAGE
android.api = 35
android.minapi = 23
android.archs = arm64-v8a,armeabi-v7a
android.accept_sdk_license = True
p4a.branch = master
